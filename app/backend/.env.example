# Copy to ".env" next to this file and fill in secrets. Never commit .env.

# --- Auth0 (OIDC) — "x.com monitoring" Regular Web Application ---
# Issuer = Auth0 domain with https, no trailing slash
OIDC_ISSUER_URL=https://dev-qoa1yjocego358t6.us.auth0.com
OIDC_CLIENT_ID=uYyoXFAYWFAifvbZp2qDcaftdxI5Crjy
# Paste from Auth0 → Application → Client Secret (never commit real .env)
OIDC_CLIENT_SECRET=PASTE_AUTH0_CLIENT_SECRET_HERE
OIDC_SCOPE=openid profile email

# App-issued JWT after Auth0 login (not the Auth0 client secret). Generate:
#   openssl rand -hex 32
JWT_SECRET_KEY=PASTE_OPENSSL_RAND_HEX_32_OUTPUT_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Match Vite dev server + Auth0 "Allowed Logout URLs": http://localhost:3000/logout-callback
FRONTEND_URL=http://localhost:3000

# Callback URL sent to Auth0 is derived from the Host header when you open login from the SPA.
# If the frontend uses http://127.0.0.1:8000 as API_BASE_URL, Auth0 must list that exact callback too,
# or pin the backend URL so it always matches Auth0:
# PYTHON_BACKEND_URL=http://localhost:8000

# Optional: first admin (use Auth0 user's `sub` from a JWT or the Auth0 user profile)
# ADMIN_USER_ID=
# ADMIN_USER_EMAIL=

# --- Database (optional; defaults to local SQLite in repo) ---
# DATABASE_URL=

# --- X + AI ---
# TWITTER_BEARER_TOKEN=

# OpenAI-compatible API (OpenRouter, OpenAI, Azure proxy, etc.) — required for rewrites / aihub
# APP_AI_BASE_URL=https://openrouter.ai/api/v1
# APP_AI_KEY=sk-or-v1-...
# Models (OpenRouter slugs). Defaults: DeepSeek Chat — inexpensive on OpenRouter vs many frontier models.
# APP_AI_REWRITE_MODEL=deepseek/deepseek-chat
# APP_AI_EXTRACT_HOOK_MODEL=deepseek/deepseek-chat
# Free tier option: APP_AI_REWRITE_MODEL=openrouter/free
